// Varal database schema (spec 01, section 12).
// Connection URL lives in prisma.config.ts; the client connects through @prisma/adapter-pg.
//
// Conventions:
// - Models in PascalCase, tables and columns in snake_case (@@map / @map).
// - Ids are UUID v7 generated by the application (`uuid(7)`): PostgreSQL 17 has no uuidv7().
// - Timestamps are timestamptz with millisecond precision (the precision of a JS Date).
// - Tenant tables have `organization_id NOT NULL` and an index starting with it (spec 01, section 6).
//   They are listed in src/prisma/tenant-models.ts, which drives the tenant-scoping extension.
// - Constraints Prisma cannot express (expression indexes, CHECKs, the audit trigger) live only in
//   the migration SQL and are listed next to each model.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------------------------

/// Subscription situation of an organization (RN-02.11).
enum SubscriptionStatus {
  pilot
  active
  suspended
  canceled

  @@map("subscription_status")
}

/// Who owns a session or a password token (spec 01, section 12).
enum SubjectType {
  owner
  staff
  platform_admin

  @@map("subject_type")
}

/// Who performed an audited action: a subject or the system itself (jobs, seed).
enum ActorType {
  owner
  staff
  platform_admin
  system

  @@map("actor_type")
}

enum PasswordTokenPurpose {
  invite
  reset

  @@map("password_token_purpose")
}

/// E-mail types of the MVP (spec 01, section 9).
enum EmailType {
  owner_invite
  owner_password_reset
  staff_password_reset
  admin_invite
  admin_password_reset

  @@map("email_type")
}

enum EmailStatus {
  queued
  sent
  failed

  @@map("email_status")
}

/// Kind of station (spec 03, section 4.1).
enum StationKind {
  counter
  queue

  @@map("station_kind")
}

/// Where an item in a workflow stage shows up (spec 03, section 4.2).
enum WorkflowStageTarget {
  product_station
  fixed_station
  none

  @@map("workflow_stage_target")
}

/// Internal state of an idempotency key (spec 01, section 5). Not part of the public contract.
enum IdempotencyStatus {
  in_progress
  completed

  @@map("idempotency_status")
}

/// Who receives an announcement (RN-02.14).
enum AnnouncementAudienceType {
  all
  by_status
  selected

  @@map("announcement_audience_type")
}

/// Lifecycle of an announcement (RN-02.15).
enum AnnouncementStatus {
  draft
  scheduled
  published
  archived

  @@map("announcement_status")
}

/// How an "entrar como" session ended (spec 02, section 9). `expired` only in the history of the
/// accesses that had the old 60-minute limit; new ones end only by the admin.
enum ImpersonationEndedBy {
  admin
  expired

  @@map("impersonation_ended_by")
}

/// Kind of shift, chosen when it opens and never changed (RN-04.04).
enum ShiftType {
  direct_sale
  contracted

  @@map("shift_type")
}

enum ShiftStatus {
  open
  closed

  @@map("shift_status")
}

/// Modality of the agreement of a contracted shift (RN-04.05).
enum AgreementModality {
  fixed_fee
  per_quantity
  consumption_billed
  other

  @@map("agreement_modality")
}

/// How a tab is paid (RN-04.11): before sending (`pay_first`, spec 05) or at the end (`open_tab`).
enum TabMode {
  pay_first
  open_tab

  @@map("tab_mode")
}

/// Situation of a tab (RN-04.12). `paid` comes with spec 05, `on_credit` and `settled` with spec 06.
enum TabStatus {
  open
  closing
  paid
  on_credit
  settled
  canceled

  @@map("tab_status")
}

/// Discount of a tab (spec 05, RN-05.01).
enum DiscountType {
  amount
  percent

  @@map("discount_type")
}

/// `sent` while some item is in a non-final stage; `completed` when every item is final or canceled.
enum OrderStatus {
  sent
  completed

  @@map("order_status")
}

/// Payment methods (spec 05, RN-05.04). Only registered: no processing.
enum PaymentMethod {
  pix
  cash
  credit_card
  debit_card

  @@map("payment_method")
}

/// Cash register of a shift (spec 05, section 5). A closed register is never reopened (RN-05.21).
enum CashRegisterStatus {
  open
  closed

  @@map("cash_register_status")
}

/// `withdrawal`: sangria; `deposit`: suprimento (RN-05.18).
enum CashMovementType {
  withdrawal
  deposit

  @@map("cash_movement_type")
}

// ---------------------------------------------------------------------------------------------
// Tenants
// ---------------------------------------------------------------------------------------------

/// The tenant. Read through the tenant client it is scoped by its own id.
/// SQL-only: CHECK access_code ~ '^[2-9A-HJ-NP-Z]{6}$' (no 0/O, 1/I).
model Organization {
  id                 String             @id @default(uuid(7)) @db.Uuid
  name               String
  /// Establishment code used by staff to log in (spec 01, section 7.1). Generated by the app.
  accessCode         String             @unique @map("access_code")
  subscriptionStatus SubscriptionStatus @default(pilot) @map("subscription_status")
  suspendedReason    String?            @map("suspended_reason")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  units                 Unit[]
  users                 User[]
  staffMembers          StaffMember[]
  staffUnitPermissions  StaffUnitPermission[]
  stations              Station[]
  workflowStages        WorkflowStage[]
  categories            Category[]
  products              Product[]
  modifierGroups        ModifierGroup[]
  modifiers             Modifier[]
  // Spec 02 (admin da plataforma).
  announcementTargets   AnnouncementTarget[]
  announcementReads     AnnouncementRead[]
  impersonationSessions ImpersonationSession[]
  // Spec 04 (turno e comandas).
  shifts                Shift[]
  shiftAgreements       ShiftAgreement[]
  shiftPrices           ShiftPrice[]
  tabs                  Tab[]
  orders                Order[]
  orderItems            OrderItem[]
  orderItemModifiers    OrderItemModifier[]
  // Spec 05 (fechamento e caixa).
  cashRegisters         CashRegister[]
  cashMovements         CashMovement[]
  cashRegisterCounts    CashRegisterCount[]
  payments              Payment[]
  customers             Customer[]

  @@map("organizations")
}

/// SQL-only: CHECK late_after_minutes BETWEEN 1 AND 240 (spec 03, section 3).
model Unit {
  id               String   @id @default(uuid(7)) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  name             String
  active           Boolean  @default(true)
  /// Minutes after which an item is shown as late (spec 03, section 3; spec 04).
  lateAfterMinutes Int      @default(15) @map("late_after_minutes")
  /// Version of the unit settings, stations and workflow (`unit.config_updated`, concurrency).
  version          Int      @default(0)
  /// Version of the menu of the unit (`menu.updated`, spec 03, section 8).
  menuVersion      Int      @default(0) @map("menu_version")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization         Organization          @relation(fields: [organizationId], references: [id])
  staffUnitPermissions StaffUnitPermission[]
  stations             Station[]
  workflowStages       WorkflowStage[]
  categories           Category[]
  products             Product[]
  shifts               Shift[]
  tabs                 Tab[]
  orderItems           OrderItem[]
  cashRegisters        CashRegister[]
  customers            Customer[]

  @@unique([organizationId, name])
  /// Target of composite foreign keys that keep child rows in the same organization.
  @@unique([organizationId, id])
  @@map("units")
}

/// Owners (`Owner` in the glossary). E-mail is unique across all organizations.
/// SQL-only: CHECK email = lower(email).
model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  name            String
  email           String    @unique
  /// Null until the invite is accepted.
  passwordHash    String?   @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization          Organization           @relation(fields: [organizationId], references: [id])
  // Spec 02 (admin da plataforma).
  announcementReads     AnnouncementRead[]
  impersonationSessions ImpersonationSession[]

  @@index([organizationId])
  @@map("users")
}

/// SQL-only: UNIQUE (organization_id, lower(username)) and CHECK username ~ '^[A-Za-z0-9._]+$'.
model StaffMember {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  username       String
  email          String?
  /// Null until a password is defined (by the owner, spec 03, or through a reset link).
  passwordHash   String?  @map("password_hash")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization          @relation(fields: [organizationId], references: [id])
  unitPermissions StaffUnitPermission[]

  @@unique([organizationId, id])
  @@map("staff_members")
}

/// Stations a staff member may open in a unit (RN-03.16). `station_ids` has no foreign key (an
/// array cannot have one): the staff service accepts only stations of the same unit, and readers
/// (`/auth/me`, real-time rooms) keep only the active stations of that unit (spec 03, README).
model StaffUnitPermission {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  staffMemberId  String   @map("staff_member_id") @db.Uuid
  unitId         String   @map("unit_id") @db.Uuid
  stationIds     String[] @default([]) @map("station_ids") @db.Uuid
  canOperateCash Boolean  @default(false) @map("can_operate_cash")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  // Composite keys: the staff member and the unit must belong to the same organization.
  staffMember  StaffMember  @relation(fields: [organizationId, staffMemberId], references: [organizationId, id])
  unit         Unit         @relation(fields: [organizationId, unitId], references: [organizationId, id])

  @@unique([staffMemberId, unitId])
  @@index([organizationId, unitId])
  @@map("staff_unit_permissions")
}

// ---------------------------------------------------------------------------------------------
// Unit setup (spec 03)
// ---------------------------------------------------------------------------------------------

/// A screen opened on a device (spec 03, section 4.1). Never deleted, only deactivated.
/// SQL-only: UNIQUE (unit_id, lower(name)).
model Station {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  unitId         String      @map("unit_id") @db.Uuid
  name           String
  kind           StationKind
  sortOrder      Int         @map("sort_order")
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id])
  unit         Unit            @relation(fields: [organizationId, unitId], references: [organizationId, id])
  stages       WorkflowStage[]
  categories   Category[]
  products     Product[]
  prepItems    OrderItem[]     @relation("OrderItemPrepStation")
  queuedItems  OrderItem[]     @relation("OrderItemStation")

  /// Target of composite foreign keys: a station referenced by a stage, category or product is
  /// always of the same organization and unit.
  @@unique([organizationId, unitId, id])
  @@index([organizationId, unitId])
  @@map("stations")
}

/// One stage of the workflow of a unit (spec 03, section 4.2). The workflow is saved at once
/// (`PUT /units/{id}/workflow`); a stage removed from it is archived (`archived_at`), never
/// deleted, so items of past shifts keep pointing to it (spec 04).
/// SQL-only: UNIQUE (unit_id, sort_order) WHERE archived_at IS NULL;
/// CHECK (target = 'fixed_station') = (station_id IS NOT NULL); CHECK is_final = (target = 'none').
model WorkflowStage {
  id             String              @id @default(uuid(7)) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  unitId         String              @map("unit_id") @db.Uuid
  name           String
  sortOrder      Int                 @map("sort_order")
  target         WorkflowStageTarget
  /// Only for `fixed_station`.
  stationId      String?             @map("station_id") @db.Uuid
  isFinal        Boolean             @default(false) @map("is_final")
  archivedAt     DateTime?           @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  unit         Unit         @relation(fields: [organizationId, unitId], references: [organizationId, id])
  station      Station?     @relation(fields: [organizationId, unitId, stationId], references: [organizationId, unitId, id], onDelete: Restrict)
  orderItems   OrderItem[]

  /// Target of the composite foreign key of `order_items.stage_id` (spec 04).
  @@unique([organizationId, unitId, id])
  @@index([organizationId, unitId])
  @@map("workflow_stages")
}

/// SQL-only: UNIQUE (unit_id, lower(name)).
model Category {
  id               String   @id @default(uuid(7)) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  unitId           String   @map("unit_id") @db.Uuid
  name             String
  sortOrder        Int      @map("sort_order")
  /// Preparation station of its products (RN-03.08); a `queue` station of the same unit.
  defaultStationId String   @map("default_station_id") @db.Uuid
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization @relation(fields: [organizationId], references: [id])
  unit           Unit         @relation(fields: [organizationId, unitId], references: [organizationId, id])
  defaultStation Station      @relation(fields: [organizationId, unitId, defaultStationId], references: [organizationId, unitId, id])
  products       Product[]

  @@unique([organizationId, unitId, id])
  @@index([organizationId, unitId])
  @@map("categories")
}

/// SQL-only: CHECK price_cents >= 0 (RN-03.09); CHECK char_length(description) <= 120.
model Product {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  unitId         String   @map("unit_id") @db.Uuid
  categoryId     String   @map("category_id") @db.Uuid
  name           String
  description    String?
  priceCents     Int      @map("price_cents")
  /// Overrides the station of the category (RN-03.08).
  stationId      String?  @map("station_id") @db.Uuid
  sortOrder      Int      @map("sort_order")
  active         Boolean  @default(true)
  soldOut        Boolean  @default(false) @map("sold_out")
  /// Incremented on every change, sold-out included (`product.sold_out_changed`).
  version        Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id])
  unit           Unit            @relation(fields: [organizationId, unitId], references: [organizationId, id])
  category       Category        @relation(fields: [organizationId, unitId, categoryId], references: [organizationId, unitId, id])
  station        Station?        @relation(fields: [organizationId, unitId, stationId], references: [organizationId, unitId, id], onDelete: Restrict)
  modifierGroups ModifierGroup[]
  shiftPrices    ShiftPrice[]
  orderItems     OrderItem[]

  @@unique([organizationId, id])
  @@index([organizationId, unitId])
  @@index([organizationId, categoryId])
  @@map("products")
}

/// SQL-only: CHECK min_choices >= 0 AND max_choices >= 1 AND min_choices <= max_choices (RN-03.13).
/// Deleting a group deletes its modifiers (ON DELETE CASCADE): items keep a copy (RN-04.18).
model ModifierGroup {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  name           String
  minChoices     Int      @map("min_choices")
  maxChoices     Int      @map("max_choices")
  sortOrder      Int      @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  product      Product      @relation(fields: [organizationId, productId], references: [organizationId, id])
  modifiers    Modifier[]

  @@unique([organizationId, id])
  @@index([organizationId, productId])
  @@map("modifier_groups")
}

/// SQL-only: CHECK price_delta_cents >= 0.
model Modifier {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  modifierGroupId String   @map("modifier_group_id") @db.Uuid
  name            String
  priceDeltaCents Int      @default(0) @map("price_delta_cents")
  sortOrder       Int      @map("sort_order")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization  @relation(fields: [organizationId], references: [id])
  modifierGroup ModifierGroup @relation(fields: [organizationId, modifierGroupId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, modifierGroupId])
  @@map("modifiers")
}

// ---------------------------------------------------------------------------------------------
// Shifts, tabs and orders (spec 04)
// ---------------------------------------------------------------------------------------------

/// A work period of a unit (spec 04, section 3). At most one open shift per unit (RN-04.01).
/// SQL-only: UNIQUE (unit_id) WHERE status = 'open'; CHECK next_tab_number >= 1;
/// CHECK (status = 'closed') = (closed_at IS NOT NULL).
model Shift {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  unitId         String      @map("unit_id") @db.Uuid
  type           ShiftType
  status         ShiftStatus @default(open)
  openedByType   ActorType   @map("opened_by_type")
  openedById     String?     @map("opened_by_id") @db.Uuid
  openedAt       DateTime    @map("opened_at") @db.Timestamptz(3)
  closedByType   ActorType?  @map("closed_by_type")
  closedById     String?     @map("closed_by_id") @db.Uuid
  closedAt       DateTime?   @map("closed_at") @db.Timestamptz(3)
  /// Number of the next tab (RN-04.09): incremented under the row lock, so two counters never get
  /// the same number (CA-04.02).
  nextTabNumber  Int         @default(1) @map("next_tab_number")
  /// Incremented on every change of the shift (prices, closing): version of `shift.*` events.
  version        Int         @default(0)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id])
  unit         Unit            @relation(fields: [organizationId, unitId], references: [organizationId, id])
  agreement    ShiftAgreement?
  prices        ShiftPrice[]
  tabs          Tab[]
  orders        Order[]
  cashRegisters CashRegister[]
  payments      Payment[]

  @@unique([organizationId, id])
  @@index([organizationId, unitId, openedAt])
  @@map("shifts")
}

/// Agreement of a contracted shift (RN-04.05). Informative in the MVP.
/// SQL-only: CHECK agreed_amount_cents >= 0; CHECK agreed_quantity >= 1.
model ShiftAgreement {
  id                String            @id @default(uuid(7)) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  shiftId           String            @map("shift_id") @db.Uuid
  contractorName    String            @map("contractor_name")
  modality          AgreementModality
  agreedAmountCents Int?              @map("agreed_amount_cents")
  agreedQuantity    Int?              @map("agreed_quantity")
  limits            String?
  notes             String?
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  shift        Shift        @relation(fields: [organizationId, shiftId], references: [organizationId, id])

  /// One agreement per shift.
  @@unique([organizationId, shiftId])
  @@map("shift_agreements")
}

/// Price of a product in one shift (RN-04.06); other products keep the menu price.
/// SQL-only: CHECK price_cents >= 0.
model ShiftPrice {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  shiftId        String   @map("shift_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  priceCents     Int      @map("price_cents")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  shift        Shift        @relation(fields: [organizationId, shiftId], references: [organizationId, id])
  product      Product      @relation(fields: [organizationId, productId], references: [organizationId, id])

  @@unique([shiftId, productId])
  @@index([organizationId, shiftId])
  @@map("shift_prices")
}

/// A tab (comanda, spec 04, section 4). Never deleted: canceled (RN-04.12).
/// `customer_id`, `credit_at` and `settled_at`: fiado (spec 06); the discount is applied by spec 05.
/// SQL-only: CHECK char_length(customer_name) BETWEEN 1 AND 40; CHECK number >= 1;
/// CHECK discount_value >= 0; CHECK (discount_type IS NULL) = (discount_value IS NULL);
/// CHECK on_credit/settled have customer_id and credit_at; CHECK (status = 'settled') = (settled_at IS NOT NULL).
model Tab {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  shiftId        String        @map("shift_id") @db.Uuid
  unitId         String        @map("unit_id") @db.Uuid
  /// Sequential in the shift, from 1 (RN-04.09).
  number         Int
  customerName   String        @map("customer_name")
  mode           TabMode
  status         TabStatus
  discountType   DiscountType? @map("discount_type")
  discountValue  Int?          @map("discount_value")
  discountReason String?       @map("discount_reason")
  openedByType   ActorType     @map("opened_by_type")
  openedById     String?       @map("opened_by_id") @db.Uuid
  /// When it left `open`/`closing` for good (paid, on credit, canceled).
  closedAt       DateTime?     @map("closed_at") @db.Timestamptz(3)
  /// Customer of a tab on credit (RN-06.05), kept after settling and after the customer is removed.
  customerId     String?       @map("customer_id") @db.Uuid
  /// When it was put on credit (spec 06, section 6).
  creditAt       DateTime?     @map("credit_at") @db.Timestamptz(3)
  /// When the balance of a tab on credit reached zero (RN-06.10).
  settledAt      DateTime?     @map("settled_at") @db.Timestamptz(3)
  /// Concurrency and version of `tab.*` events: incremented on status, orders and totals changes.
  version        Int           @default(0)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  shift        Shift        @relation(fields: [organizationId, shiftId], references: [organizationId, id])
  unit         Unit         @relation(fields: [organizationId, unitId], references: [organizationId, id])
  customer     Customer?    @relation(fields: [organizationId, customerId], references: [organizationId, id])
  orders       Order[]
  items        OrderItem[]
  payments     Payment[]

  @@unique([shiftId, number])
  @@unique([organizationId, id])
  @@index([organizationId, shiftId, status])
  @@index([organizationId, unitId, status])
  @@index([organizationId, customerId])
  @@map("tabs")
}

/// An order sent from the counter (spec 04, section 5). Never deleted.
/// SQL-only: CHECK number_in_tab >= 1; CHECK (status = 'completed') = (completed_at IS NOT NULL).
model Order {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  tabId          String      @map("tab_id") @db.Uuid
  shiftId        String      @map("shift_id") @db.Uuid
  /// 1, 2, 3… in the tab.
  numberInTab    Int         @map("number_in_tab")
  status         OrderStatus @default(sent)
  createdByType  ActorType   @map("created_by_type")
  createdById    String?     @map("created_by_id") @db.Uuid
  sentAt         DateTime    @map("sent_at") @db.Timestamptz(3)
  completedAt    DateTime?   @map("completed_at") @db.Timestamptz(3)
  /// Version of `order.*` events.
  version        Int         @default(0)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  tab          Tab          @relation(fields: [organizationId, tabId], references: [organizationId, id])
  shift        Shift        @relation(fields: [organizationId, shiftId], references: [organizationId, id])
  items        OrderItem[]

  @@unique([tabId, numberInTab])
  @@unique([organizationId, id])
  @@index([organizationId, tabId])
  @@map("orders")
}

/// One line of an order with a copy of what was sold (RN-04.18): name, unit price of the moment and
/// preparation station. Splitting a line (advance part of it, RN-04.24, or cancel part of it,
/// RN-04.26) creates a new line pointing to the original in `split_from_id`.
/// `station_id` is the station where the line shows up now (from the stage, spec 03 section 4.2),
/// null in the final stage or when canceled. Never deleted.
/// SQL-only: CHECK quantity BETWEEN 1 AND 99; CHECK unit_price_cents >= 0;
/// CHECK note IS NULL OR char_length(note) <= 140; CHECK cancel_reason length <= 140;
/// CHECK (canceled_at IS NULL) = (cancel_reason IS NULL); CHECK canceled lines have no station.
model OrderItem {
  id             String     @id @default(uuid(7)) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  orderId        String     @map("order_id") @db.Uuid
  tabId          String     @map("tab_id") @db.Uuid
  unitId         String     @map("unit_id") @db.Uuid
  productId      String     @map("product_id") @db.Uuid
  productName    String     @map("product_name")
  unitPriceCents Int        @map("unit_price_cents")
  quantity       Int
  note           String?
  /// Position of the line in the order as sent (split lines keep the position of the original).
  position       Int
  prepStationId  String     @map("prep_station_id") @db.Uuid
  stageId        String     @map("stage_id") @db.Uuid
  stationId      String?    @map("station_id") @db.Uuid
  stageEnteredAt DateTime   @map("stage_entered_at") @db.Timestamptz(3)
  canceledAt     DateTime?  @map("canceled_at") @db.Timestamptz(3)
  canceledByType ActorType? @map("canceled_by_type")
  canceledById   String?    @map("canceled_by_id") @db.Uuid
  cancelReason   String?    @map("cancel_reason")
  /// Canceled after leaving the first stage (RN-04.27).
  wasted         Boolean    @default(false)
  splitFromId    String?    @map("split_from_id") @db.Uuid
  /// Optimistic concurrency of every stage change and cancellation (`ITEM_CHANGED`).
  version        Int        @default(0)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id])
  order        Order               @relation(fields: [organizationId, orderId], references: [organizationId, id])
  tab          Tab                 @relation(fields: [organizationId, tabId], references: [organizationId, id])
  unit         Unit                @relation(fields: [organizationId, unitId], references: [organizationId, id])
  product      Product             @relation(fields: [organizationId, productId], references: [organizationId, id])
  stage        WorkflowStage       @relation(fields: [organizationId, unitId, stageId], references: [organizationId, unitId, id])
  prepStation  Station             @relation("OrderItemPrepStation", fields: [organizationId, unitId, prepStationId], references: [organizationId, unitId, id])
  station      Station?            @relation("OrderItemStation", fields: [organizationId, unitId, stationId], references: [organizationId, unitId, id])
  splitFrom    OrderItem?          @relation("OrderItemSplit", fields: [organizationId, splitFromId], references: [organizationId, id])
  splits       OrderItem[]         @relation("OrderItemSplit")
  modifiers    OrderItemModifier[]

  @@unique([organizationId, id])
  @@index([organizationId, orderId])
  @@index([organizationId, tabId])
  @@index([organizationId, stationId])
  @@map("order_items")
}

/// Copy of a chosen modifier (RN-04.18). `modifier_id` has no foreign key: modifier groups can be
/// deleted from the menu (spec 03, section 5.2), and the item keeps its copy.
/// SQL-only: CHECK price_delta_cents >= 0.
model OrderItemModifier {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  orderItemId     String   @map("order_item_id") @db.Uuid
  modifierId      String   @map("modifier_id") @db.Uuid
  groupName       String   @map("group_name")
  modifierName    String   @map("modifier_name")
  priceDeltaCents Int      @map("price_delta_cents")
  /// Order of the copy (group order, then option order of the menu at the moment of the sale).
  position        Int
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  orderItem    OrderItem    @relation(fields: [organizationId, orderItemId], references: [organizationId, id])

  @@index([organizationId, orderItemId])
  @@map("order_item_modifiers")
}

/// A cash register of a shift (spec 05, section 5): several may be open at once (RN-05.17).
/// SQL-only: CHECK opening_float_cents >= 0; CHECK name 1..40 characters;
/// CHECK (status = 'closed') = (closed_at IS NOT NULL); unique (shift_id, lower(name)).
model CashRegister {
  id                String             @id @default(uuid(7)) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  shiftId           String             @map("shift_id") @db.Uuid
  unitId            String             @map("unit_id") @db.Uuid
  name              String
  status            CashRegisterStatus @default(open)
  /// Fundo de troco, in cash (RN-05.17).
  openingFloatCents Int                @map("opening_float_cents")
  openedByType      ActorType          @map("opened_by_type")
  openedById        String?            @map("opened_by_id") @db.Uuid
  openedAt          DateTime           @map("opened_at") @db.Timestamptz(3)
  closedByType      ActorType?         @map("closed_by_type")
  closedById        String?            @map("closed_by_id") @db.Uuid
  closedAt          DateTime?          @map("closed_at") @db.Timestamptz(3)
  /// Required when any method closes with a difference (RN-05.20).
  closingNote       String?            @map("closing_note")
  /// Incremented on every payment, reversal, movement and on closing: version of `cash_register.*`.
  version           Int                @default(0)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id])
  shift        Shift               @relation(fields: [organizationId, shiftId], references: [organizationId, id])
  unit         Unit                @relation(fields: [organizationId, unitId], references: [organizationId, id])
  movements    CashMovement[]
  counts       CashRegisterCount[]
  payments     Payment[]

  @@unique([organizationId, id])
  @@index([organizationId, shiftId, status])
  @@map("cash_registers")
}

/// Sangria or suprimento (RN-05.18). Never deleted.
/// SQL-only: CHECK amount_cents > 0; CHECK reason 1..140 characters.
model CashMovement {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  cashRegisterId String           @map("cash_register_id") @db.Uuid
  type           CashMovementType
  amountCents    Int              @map("amount_cents")
  reason         String
  createdByType  ActorType        @map("created_by_type")
  createdById    String?          @map("created_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  cashRegister CashRegister @relation(fields: [organizationId, cashRegisterId], references: [organizationId, id])

  @@index([organizationId, cashRegisterId])
  @@map("cash_movements")
}

/// What was counted per method when the register closed (RN-05.20).
/// SQL-only: CHECK informed_cents >= 0; CHECK difference_cents = informed_cents - expected_cents.
model CashRegisterCount {
  id              String        @id @default(uuid(7)) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  cashRegisterId  String        @map("cash_register_id") @db.Uuid
  method          PaymentMethod
  expectedCents   Int           @map("expected_cents")
  informedCents   Int           @map("informed_cents")
  differenceCents Int           @map("difference_cents")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  cashRegister CashRegister @relation(fields: [organizationId, cashRegisterId], references: [organizationId, id])

  @@unique([cashRegisterId, method])
  @@index([organizationId, cashRegisterId])
  @@map("cash_register_counts")
}

/// A registered payment (spec 05, section 4). Reversed, never deleted (RN-05.15). `shift_id` is the
/// shift the money came in, which differs from the tab's on a credit settlement (spec 06).
/// SQL-only: CHECK amount_cents > 0; cash has tendered/change (tendered = amount + change), the
/// other methods have neither; reversal fields all set or all null, reason 1..140 characters.
model Payment {
  id                 String        @id @default(uuid(7)) @db.Uuid
  organizationId     String        @map("organization_id") @db.Uuid
  tabId              String        @map("tab_id") @db.Uuid
  shiftId            String        @map("shift_id") @db.Uuid
  cashRegisterId     String        @map("cash_register_id") @db.Uuid
  method             PaymentMethod
  /// Applied amount (RN-05.09).
  amountCents        Int           @map("amount_cents")
  tenderedCents      Int?          @map("tendered_cents")
  changeCents        Int?          @map("change_cents")
  /// Settlement of a tab on credit (spec 06).
  isCreditSettlement Boolean       @default(false) @map("is_credit_settlement")
  receivedByType     ActorType     @map("received_by_type")
  receivedById       String?       @map("received_by_id") @db.Uuid
  reversedAt         DateTime?     @map("reversed_at") @db.Timestamptz(3)
  reversedByType     ActorType?    @map("reversed_by_type")
  reversedById       String?       @map("reversed_by_id") @db.Uuid
  reversalReason     String?       @map("reversal_reason")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  tab          Tab          @relation(fields: [organizationId, tabId], references: [organizationId, id])
  shift        Shift        @relation(fields: [organizationId, shiftId], references: [organizationId, id])
  cashRegister CashRegister @relation(fields: [organizationId, cashRegisterId], references: [organizationId, id])

  @@index([organizationId, tabId])
  @@index([organizationId, cashRegisterId])
  @@map("payments")
}

// ---------------------------------------------------------------------------------------------
// Platform
// ---------------------------------------------------------------------------------------------

/// Varal team members, with roles and extra permissions (RBAC, spec 02, section 3).
/// SQL-only: CHECK email = lower(email).
model PlatformAdmin {
  id           String    @id @default(uuid(7)) @db.Uuid
  name         String
  email        String    @unique
  /// Null until the invite is accepted.
  passwordHash String?   @map("password_hash")
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles                 PlatformAdminRole[]
  permissions           PlatformAdminPermission[]
  announcements         Announcement[]
  impersonationSessions ImpersonationSession[]

  @@map("platform_admins")
}

// ---------------------------------------------------------------------------------------------
// Authentication (phase 1b)
// ---------------------------------------------------------------------------------------------

/// One row per device login (spec 01, section 7.2). `organization_id` is null for platform admins.
model Session {
  id                       String      @id @default(uuid(7)) @db.Uuid
  subjectType              SubjectType @map("subject_type")
  subjectId                String      @map("subject_id") @db.Uuid
  organizationId           String?     @map("organization_id") @db.Uuid
  deviceId                 String      @map("device_id") @db.Uuid
  /// SHA-256 of the secret part of the current refresh token (the token itself is never stored).
  refreshTokenHash         String      @unique @map("refresh_token_hash")
  /// Hash of the token replaced by the last rotation: presenting it again is a reuse (theft) and
  /// revokes the session, except right after the rotation (concurrent refresh, see SessionService).
  previousRefreshTokenHash String?     @map("previous_refresh_token_hash")
  /// Last rotation of the refresh token.
  refreshedAt              DateTime?   @map("refreshed_at") @db.Timestamptz(3)
  /// Sliding: every rotation pushes it 30 days ahead (spec 01, section 7.2).
  expiresAt                DateTime    @map("expires_at") @db.Timestamptz(3)
  revokedAt                DateTime?   @map("revoked_at") @db.Timestamptz(3)
  /// `logout`, `password_changed`, `password_reset`, `refresh_token_reused`, `staff_deactivated`…
  revokedReason            String?     @map("revoked_reason")
  lastUsedAt               DateTime?   @map("last_used_at") @db.Timestamptz(3)
  userAgent                String?     @map("user_agent")
  ip                       String?
  /// "Entrar como" session (spec 02, RN-02.21): the session acts as the owner on behalf of an admin.
  impersonationId          String?     @map("impersonation_id") @db.Uuid
  createdAt                DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  impersonation ImpersonationSession? @relation(fields: [impersonationId], references: [id])

  @@index([subjectType, subjectId])
  @@index([organizationId])
  @@index([expiresAt])
  @@index([impersonationId])
  @@map("sessions")
}

/// Invite and reset links (spec 01, section 7.4). Only the hash of the token is stored.
model PasswordToken {
  id          String               @id @default(uuid(7)) @db.Uuid
  subjectType SubjectType          @map("subject_type")
  subjectId   String               @map("subject_id") @db.Uuid
  purpose     PasswordTokenPurpose
  tokenHash   String               @unique @map("token_hash")
  expiresAt   DateTime             @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime?            @map("used_at") @db.Timestamptz(3)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([subjectType, subjectId, purpose])
  @@index([createdAt])
  @@map("password_tokens")
}

/// Consecutive failed logins per identifier (spec 01, section 7.3): 10 in a row lock the identifier
/// for 15 minutes. Rows exist for unknown identifiers too, so the lock never reveals whether a user
/// exists. `key` is a SHA-256 of `<context>:<identifier>` (no e-mail in clear text).
model LoginThrottle {
  id           String    @id @default(uuid(7)) @db.Uuid
  key          String    @unique
  failedCount  Int       @default(0) @map("failed_count")
  lockedUntil  DateTime? @map("locked_until") @db.Timestamptz(3)
  lastFailedAt DateTime  @map("last_failed_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([lastFailedAt])
  @@map("login_throttles")
}

// ---------------------------------------------------------------------------------------------
// Cross-cutting
// ---------------------------------------------------------------------------------------------

/// Insert-only (spec 01, section 8): no updated_at, and a trigger rejects UPDATE and DELETE.
/// `organization_id` is null for platform-only actions.
model AuditLog {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String?   @map("organization_id") @db.Uuid
  actorType       ActorType @map("actor_type")
  actorId         String?   @map("actor_id") @db.Uuid
  impersonatorId  String?   @map("impersonator_id") @db.Uuid
  /// "Entrar como" session of the action (RN-02.20), with `impersonator_id`. No foreign key: the
  /// audit outlives everything else.
  impersonationId String?   @map("impersonation_id") @db.Uuid
  /// `<entity>.<verb>`, e.g. `tab.discount_applied`.
  action          String
  entityType      String    @map("entity_type")
  entityId        String?   @map("entity_id") @db.Uuid
  /// `{ before: {...}, after: {...} }` with changed fields only.
  changes         Json      @default("{}")
  deviceId        String?   @map("device_id") @db.Uuid
  ip              String?
  requestId       String?   @map("request_id")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model EmailLog {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String?     @map("organization_id") @db.Uuid
  to             String
  type           EmailType
  status         EmailStatus @default(queued)
  error          String?
  sentAt         DateTime?   @map("sent_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt])
  @@index([createdAt])
  @@map("email_logs")
}

/// Stored responses of writes sent with `Idempotency-Key` (spec 01, section 5), kept for 24 h.
model IdempotencyKey {
  id             String            @id @default(uuid(7)) @db.Uuid
  key            String            @db.Uuid
  subjectId      String            @map("subject_id") @db.Uuid
  organizationId String?           @map("organization_id") @db.Uuid
  /// SHA-256 of method, path and canonical body: the same key with another request is a 409.
  requestHash    String            @map("request_hash")
  status         IdempotencyStatus @default(in_progress)
  statusCode     Int?              @map("status_code")
  response       Json?
  /// When the current attempt started; a stale in-progress claim can be taken over.
  lockedAt       DateTime          @map("locked_at") @db.Timestamptz(3)
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([subjectId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------------------------
// Platform admin (spec 02)
// ---------------------------------------------------------------------------------------------

/// Groups of permissions (RN-02.02). System roles come from the migration (RN-02.04) and have a
/// `system_key`; Super admin (`super_admin`) has every permission of the catalog, computed in code,
/// so it has no `role_permissions` rows.
model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique
  description String   @default("")
  isSystem    Boolean  @default(false) @map("is_system")
  /// `super_admin`, `support`, `finance`, `read_only` for system roles; null for custom ones.
  systemKey   String?  @unique @map("system_key")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  admins      PlatformAdminRole[]

  @@map("roles")
}

/// Permission keys of a role (catalog in src/admin/rbac/permissions.ts, RN-02.03).
model RolePermission {
  id         String   @id @default(uuid(7)) @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  permission String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@map("role_permissions")
}

model PlatformAdminRole {
  id              String   @id @default(uuid(7)) @db.Uuid
  platformAdminId String   @map("platform_admin_id") @db.Uuid
  roleId          String   @map("role_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  platformAdmin PlatformAdmin @relation(fields: [platformAdminId], references: [id])
  role          Role          @relation(fields: [roleId], references: [id])

  @@unique([platformAdminId, roleId])
  @@index([roleId])
  @@map("platform_admin_roles")
}

/// Extra permissions of one admin, added to those of the roles (RN-02.02).
model PlatformAdminPermission {
  id              String   @id @default(uuid(7)) @db.Uuid
  platformAdminId String   @map("platform_admin_id") @db.Uuid
  permission      String
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  platformAdmin PlatformAdmin @relation(fields: [platformAdminId], references: [id])

  @@unique([platformAdminId, permission])
  @@map("platform_admin_permissions")
}

/// Announcements to owners (spec 02, section 5). Platform data: no `organization_id`.
model Announcement {
  id               String                   @id @default(uuid(7)) @db.Uuid
  /// Up to 80 characters (RN-02.13).
  title            String
  /// Simple markdown, up to 2,000 characters (RN-02.13). Frozen once published (RN-02.15).
  body             String
  audienceType     AnnouncementAudienceType @map("audience_type")
  /// Only for `by_status`.
  audienceStatuses SubscriptionStatus[]     @default([]) @map("audience_statuses")
  status           AnnouncementStatus       @default(draft)
  /// When a scheduled announcement becomes visible.
  publishAt        DateTime?                @map("publish_at") @db.Timestamptz(3)
  publishedAt      DateTime?                @map("published_at") @db.Timestamptz(3)
  archivedAt       DateTime?                @map("archived_at") @db.Timestamptz(3)
  createdById      String                   @map("created_by") @db.Uuid
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy PlatformAdmin        @relation(fields: [createdById], references: [id])
  targets   AnnouncementTarget[]
  reads     AnnouncementRead[]

  @@index([status, publishAt])
  @@map("announcements")
}

/// Organizations chosen one by one (`selected` audience).
model AnnouncementTarget {
  id             String   @id @default(uuid(7)) @db.Uuid
  announcementId String   @map("announcement_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([announcementId, organizationId])
  @@index([organizationId])
  @@map("announcement_targets")
}

/// One read per owner (RN-02.16). Tenant data: has the organization of the owner.
model AnnouncementRead {
  id             String   @id @default(uuid(7)) @db.Uuid
  announcementId String   @map("announcement_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  readAt         DateTime @default(now()) @map("read_at") @db.Timestamptz(3)

  announcement Announcement @relation(fields: [announcementId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([announcementId, userId])
  @@index([organizationId, announcementId])
  @@map("announcement_reads")
}

/// "Entrar como" (spec 02, section 7). Tenant data: the owner lists the support accesses of the
/// organization (RN-02.22). The admin opens the panel with a one-time handoff token (only its hash is
/// stored), exchanged by the panel for a session cookie of the customers' app (RN-02.21).
model ImpersonationSession {
  id               String                @id @default(uuid(7)) @db.Uuid
  organizationId   String                @map("organization_id") @db.Uuid
  platformAdminId  String                @map("platform_admin_id") @db.Uuid
  /// The owner the admin acts as (RN-02.18).
  ownerId          String                @map("owner_id") @db.Uuid
  /// Optional, kept for compatibility: the admin is no longer asked for a reason (RN-02.17).
  reason           String?
  startedAt        DateTime              @map("started_at") @db.Timestamptz(3)
  /// Always null: an "entrar como" has no deadline and lasts until the admin ends it (RN-02.17).
  /// Kept only for the history of the accesses that had the old 60-minute limit.
  expiresAt        DateTime?             @map("expires_at") @db.Timestamptz(3)
  endedAt          DateTime?             @map("ended_at") @db.Timestamptz(3)
  endedBy          ImpersonationEndedBy? @map("ended_by")
  /// SHA-256 of the one-time handoff token; null once used.
  handoffTokenHash String?               @unique @map("handoff_token_hash")
  handoffExpiresAt DateTime?             @map("handoff_expires_at") @db.Timestamptz(3)
  handoffUsedAt    DateTime?             @map("handoff_used_at") @db.Timestamptz(3)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization  @relation(fields: [organizationId], references: [id])
  platformAdmin PlatformAdmin @relation(fields: [platformAdminId], references: [id])
  owner         User          @relation(fields: [ownerId], references: [id])
  sessions      Session[]

  @@index([organizationId, startedAt])
  @@index([platformAdminId])
  @@index([expiresAt])
  @@map("impersonation_sessions")
}

/// A customer of the fiado (spec 06, section 3), per unit (RN-06.01). Only the name is required;
/// phone, CPF, reference and note tell apart customers with the same name. Removing at the
/// customer's request (LGPD, RN-06.03) anonymizes the row and keeps its tabs.
/// SQL-only: CHECK name 1..60 characters; CHECK phone 10 or 11 digits; CHECK cpf 11 digits;
/// CHECK reference <= 60 and note <= 140 characters; CHECK an anonymized row has no personal data;
/// unique (unit_id, phone) and (unit_id, cpf) among the rows not anonymized (RN-06.02).
model Customer {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  unitId         String    @map("unit_id") @db.Uuid
  name           String
  /// Digits only, with the area code (DDD).
  phone          String?
  /// Digits only, valid check digits.
  cpf            String?
  reference      String?
  note           String?
  anonymizedAt   DateTime? @map("anonymized_at") @db.Timestamptz(3)
  version        Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  unit         Unit         @relation(fields: [organizationId, unitId], references: [organizationId, id])
  tabs         Tab[]

  @@unique([organizationId, id])
  @@index([organizationId, unitId])
  @@map("customers")
}
