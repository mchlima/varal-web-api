# Variáveis da API do Varal. Copie para .env (ou deixe o scripts/worktree.sh gerar o .env.local).
# Em desenvolvimento a API carrega .env.local e depois .env; o primeiro que define a chave vence,
# e variáveis já presentes no ambiente vencem os dois. Em produção só vale o ambiente real.

# development | test | production
NODE_ENV=development

# Porta HTTP da API: 3000 + PORT_OFFSET (spec 01, RN-01.08). O checkout principal usa 3000.
PORT=3000

# PostgreSQL. Em desenvolvimento, o Postgres do ../varal-infra/dev/compose.yml (varal/varal, porta 5432),
# com um banco por worktree: varal_<slug> (RN-01.06). Em produção, o banco e o usuário varal (RN-01.16).
DATABASE_URL=postgresql://varal:varal@localhost:5432/varal

# Banco dos testes de integração, recriado a cada `pnpm test` (precisa terminar em _test).
# Sem ele, os testes de integração são pulados.
DATABASE_URL_TEST=postgresql://varal:varal@localhost:5432/varal_test

# Origens exatas liberadas no CORS com credenciais, separadas por vírgula. Nunca `*` (RN-01.20).
# Produção: https://varal.kratinho.com.br,https://admin-varal.kratinho.com.br
CORS_ORIGINS=http://localhost:3100,http://localhost:3200

# Preenchidos pelo scripts/worktree.sh no .env.local de cada worktree (RN-01.07).
# WORKTREE_SLUG=
# PORT_OFFSET=0
