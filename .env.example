# Variáveis da API do Varal. Copie para .env (ou deixe o scripts/worktree.sh gerar o .env.local).
# Em desenvolvimento a API carrega .env.local e depois .env; o primeiro que define a chave vence,
# e variáveis já presentes no ambiente vencem os dois. Em produção só vale o ambiente real.

# development | test | production
NODE_ENV=development

# Porta HTTP da API: 3000 + PORT_OFFSET (spec 01, RN-01.08). O checkout principal usa 3000.
PORT=3000

# PostgreSQL. Em desenvolvimento, o Postgres do ../varal-infra/dev/compose.yml (varal/varal, porta 5432),
# com um banco por worktree: varal_<slug> (RN-01.06). Em produção, o banco e o usuário varal (RN-01.16).
DATABASE_URL=postgresql://varal:varal@localhost:5432/varal

# Banco dos testes de integração, recriado a cada `pnpm test` (precisa terminar em _test).
# Sem ele, os testes de integração são pulados.
DATABASE_URL_TEST=postgresql://varal:varal@localhost:5432/varal_test

# Origens exatas liberadas no CORS com credenciais, separadas por vírgula. Nunca `*` (RN-01.20).
# Produção: https://varal.kratinho.com.br,https://admin-varal.kratinho.com.br
CORS_ORIGINS=http://localhost:3100,http://localhost:3200

# Segredos de assinatura do token de acesso (JWT), um por contexto: app dos clientes e admin
# (spec 01, seção 7.2; CA-01.04). Pelo menos 32 caracteres e diferentes entre si. Obrigatórios em
# produção; fora dela, se vazios, a API gera valores aleatórios a cada início (as sessões caem no restart).
# Gere com: LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 48
AUTH_PANEL_JWT_SECRET=
AUTH_ADMIN_JWT_SECRET=
# Cifra os dados dos jobs de e-mail (destinatário e link com o token) na tabela do pg-boss.
EMAIL_PAYLOAD_SECRET=

# SMTP (spec 01, seção 9). Desenvolvimento: Mailpit (sem autenticação nem TLS; caixa em http://localhost:8025).
# Produção: SMTP Locaweb; SMTP_USER e SMTP_PASSWORD obrigatórios (ficam só no .env do VPS, nunca no git).
SMTP_HOST=localhost
SMTP_PORT=1025
# true para TLS direto (porta 465); com false, em produção a API exige STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Varal <nao-responda@kratinho.com.br>
# Onde pedir ajuda, no rodapé de todo e-mail (RN-01.21). Opcional.
SUPPORT_CONTACT=

# Fronts que recebem os links de convite e redefinição (https em produção).
# Produção: https://varal.kratinho.com.br e https://admin-varal.kratinho.com.br
PANEL_URL=http://localhost:3100
ADMIN_URL=http://localhost:3200

# Preenchidos pelo scripts/worktree.sh no .env.local de cada worktree (RN-01.07).
# WORKTREE_SLUG=
# PORT_OFFSET=0
